---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import "../../styles/prose.css";
import Base from "../../layouts/Base.astro";
import Signup from "../../components/Signup.astro";
import Scoreboard from "../../components/Scoreboard.astro";
import { getEntries, entryLabel, formatDate, type LogEntry } from "../../lib/log";

export const getStaticPaths = (async () => {
  const entries = await getEntries(); // newest first
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      newer: entries[index - 1],
      older: entries[index + 1],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: LogEntry;
  newer?: LogEntry;
  older?: LogEntry;
}

const { entry, newer, older } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Base
  title={data.title}
  description={data.summary}
  hasSignup
  ogImage={`/og/${entry.id}.png`}
  article={{ publishedTime: data.date, tags: data.tags }}
>
  <article class="post wrap-narrow">
    <header class="post-head">
      <a class="post-back" href="/log">← All entries</a>
      <p class="eyebrow">
        {entryLabel(data.entry)} ·{" "}
        <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time>
      </p>
      <h1 class="post-title">{data.title}</h1>
      <p class="post-summary">{data.summary}</p>
      <ul class="tags" aria-label="Tags">
        {data.tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    </header>

    <div class="prose">
      <Content />
    </div>

    <section class="post-damage" aria-labelledby="damage-title">
      <h2 id="damage-title" class="post-damage-title">This entry's damage</h2>
      <Scoreboard scores={data.scoreboard} />
    </section>
  </article>

  <div class="post-after wrap-narrow">
    <Signup variant="inline" />

    {
      (older || newer) && (
        <nav class="post-nav" aria-label="More entries">
          {older ? (
            <a class="post-nav-link" href={`/log/${older.id}`} rel="prev">
              <span class="post-nav-label hand">← Previous · {entryLabel(older.data.entry)}</span>
              <span class="post-nav-title">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a class="post-nav-link post-nav-next" href={`/log/${newer.id}`} rel="next">
              <span class="post-nav-label hand">{entryLabel(newer.data.entry)} · Next →</span>
              <span class="post-nav-title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </div>
</Base>

<style>
  .post {
    padding-block: 56px 56px;
  }

  .post-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 40px;
  }

  .post-back {
    align-self: flex-start;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .post-title {
    font-size: clamp(2rem, 1.4rem + 3vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .post-summary {
    color: var(--text-muted);
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .post-damage {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 64px;
  }

  .post-damage-title {
    font-size: 1.75rem;
  }

  .post-after {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-bottom: 96px;
  }

  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--card-shadow);
    color: var(--text);
    text-decoration: none;
  }

  .post-nav-link:hover,
  .post-nav-link:focus-visible {
    color: var(--text);
    transform: translate(2px, 2px);
    box-shadow: 3px 3px 0 #1c1c1c;
  }

  .post-nav-next {
    grid-column: 2;
    text-align: right;
  }

  .post-nav-label {
    color: var(--red-pen);
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .post-nav-title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .post-nav-link {
      transition:
        transform 120ms ease,
        box-shadow 120ms ease;
    }
  }

  @media (max-width: 639.98px) {
    .post {
      padding-block: 32px 48px;
    }

    .post-head {
      margin-bottom: 32px;
    }

    .post-summary {
      font-size: 1.125rem;
    }

    .post-damage {
      margin-top: 48px;
    }

    .post-after {
      padding-bottom: 64px;
    }

    .post-nav {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-nav-next {
      grid-column: 1;
      text-align: left;
    }
  }
</style>
