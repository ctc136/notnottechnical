---
import Base from "../../layouts/Base.astro";
import EntryCard from "../../components/EntryCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import Signup from "../../components/Signup.astro";
import { getEntries, type LogEntry } from "../../lib/log";

const entries = await getEntries();

// Group by year, keeping the newest-first order.
const years = new Map<number, LogEntry[]>();
for (const entry of entries) {
  const year = entry.data.date.getUTCFullYear();
  years.set(year, [...(years.get(year) ?? []), entry]);
}
---

<Base title="The log" description="Every entry in the build log, newest first." hasSignup={entries.length === 0}>
  <div class="log wrap">
    <header class="log-head">
      <p class="eyebrow">every entry, newest first</p>
      <h1 class="log-title">The log</h1>
    </header>

    {
      entries.length === 0 && (
        <div class="log-empty">
          <EmptyState subscribeHref="#bd-email" />
          <p class="log-empty-text">
            The first entry is being written. Once it's out, every entry will be listed here, newest
            first, each with its own scoreboard of hours spent, things shipped and things broken.
          </p>
          <Signup variant="inline" />
        </div>
      )
    }

    {
      [...years].map(([year, yearEntries]) => (
        <section class="log-year" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`} class="log-year-title">
            <span class="highlight">{year}</span>
          </h2>
          <ul class="log-grid">
            {yearEntries.map((entry) => (
              <li>
                <EntryCard entry={entry} showTags />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .log {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: 56px 96px;
  }

  .log-head {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .log-title {
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .log-empty {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 780px;
  }

  .log-empty-text {
    color: var(--text-muted);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .log-year {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .log-year-title {
    font-size: 1.75rem;
  }

  .log-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 24px;
    list-style: none;
  }

  @media (max-width: 639.98px) {
    .log {
      gap: 32px;
      padding-block: 32px 64px;
    }

    .log-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }
</style>
