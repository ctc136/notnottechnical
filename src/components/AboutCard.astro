---
import Avatar from "./Avatar.astro";

interface Props {
  /** "h2" for the home page teaser, "h1" on /about where it is the page title. */
  level?: "h1" | "h2";
}

const { level: Title = "h2" } = Astro.props;
---

<div class="about-card">
  <div class="about-side">
    <Title class="about-title">Who's writing this?</Title>
    <Avatar />
  </div>
  <div class="about-body">
    <slot />
  </div>
</div>

<style>
  .about-card {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    padding: 40px;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }

  .about-side {
    display: flex;
    flex: 1 1 220px;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .about-title {
    color: var(--ink);
    font-family: var(--font-hand);
    font-size: 2.25rem;
    line-height: 1.2;
  }

  .about-body {
    display: flex;
    flex: 2 1 460px;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    color: #2b2b2b;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .about-body :global(h2) {
    margin-top: 12px;
    color: var(--text);
    font-size: 1.5rem;
  }

  @media (max-width: 639.98px) {
    .about-card {
      gap: 24px;
      padding: 24px;
    }

    .about-side {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 20px;
    }

    .about-side :global(.avatar) {
      max-width: 112px;
    }
  }
</style>
