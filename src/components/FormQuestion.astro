---
// A printed form question ("Would you consider yourself technical?") with a
// third answer written in by hand. The circles are real radio buttons, so
// clicking Yes or No gets a red-pen reply. CSS only: nothing is sent anywhere.
import HandArrow from "./HandArrow.astro";
---

<div class="formq" role="radiogroup" aria-labelledby="formq-question">
  <p id="formq-question" class="formq-question">Would you consider yourself technical?</p>
  <div class="formq-options">
    <div class="formq-option">
      <input class="formq-input visually-hidden" type="radio" name="technical" id="formq-yes" />
      <label for="formq-yes"><span class="formq-radio" aria-hidden="true"></span>Yes</label>
      <span class="formq-note"><HandArrow />nice. I'm taking notes.</span>
    </div>
    <div class="formq-option">
      <input class="formq-input visually-hidden" type="radio" name="technical" id="formq-no" />
      <label for="formq-no"><span class="formq-radio" aria-hidden="true"></span>No</label>
      <span class="formq-note"><HandArrow />same. for now.</span>
    </div>
    <div class="formq-option">
      <input class="formq-input visually-hidden" type="radio" name="technical" id="formq-notnot" checked />
      <label for="formq-notnot">
        <svg class="formq-drawn" viewBox="0 0 24 24" aria-hidden="true">
          <path
            class="formq-drawn-ring"
            d="M12.4 2.7c5.4-.4 9.4 3.5 9.2 9.1-.2 5.5-4.3 9.6-9.7 9.5-5.5-.1-9.5-4.3-9.3-9.7C2.8 6.4 6.7 2.8 13 2.4"
          ></path>
          <path
            class="formq-drawn-dot"
            d="M12.1 7.4c2.6-.2 4.7 1.9 4.6 4.5-.1 2.6-2.2 4.6-4.8 4.5-2.5-.1-4.5-2.2-4.3-4.8.2-2.3 2-4 4.5-4.2z"
          ></path>
        </svg>
        <span class="formq-answer">not not</span>
      </label>
      <span class="formq-note"><HandArrow />they forgot one</span>
    </div>
  </div>
</div>

<style>
  /* The sheet: a clipping from somebody else's form, set down on the notebook. */
  .formq {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px 48px;
    max-width: 860px;
    margin-inline: auto;
    padding: 32px 36px;
    background: var(--card);
    box-shadow: var(--sticky-shadow);
    transform: rotate(-1deg);
  }

  /* The printed parts stay in plain Inter, like the form they came from. */
  .formq-question {
    flex: 1 1 300px;
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .formq-options {
    display: flex;
    flex: 0 1 auto;
    flex-direction: column;
    gap: 10px;
    /* Wide enough for the longest note, so the sheet doesn't resize on click. */
    min-width: min(100%, 370px);
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .formq-option {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    min-height: 34px;
  }

  .formq-option label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding-block: 4px;
    cursor: pointer;
  }

  .formq-radio {
    flex: none;
    width: 22px;
    height: 22px;
    border: 1.5px solid var(--text-soft);
    border-radius: 50%;
    background: #fff;
  }

  .formq-input:checked + label .formq-radio {
    background: radial-gradient(circle, var(--text) 0 5px, #fff 5.5px);
  }

  .formq-input:focus-visible + label {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    border-radius: var(--radius-small);
  }

  /* The handwritten parts: an extra circle, drawn in, and red-pen notes. */
  .formq-drawn {
    flex: none;
    width: 26px;
    height: 26px;
    margin: -2px;
    overflow: visible;
  }

  .formq-drawn-ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .formq-drawn-dot {
    fill: var(--ink);
    opacity: 0;
  }

  .formq-input:checked + label .formq-drawn-dot {
    opacity: 1;
  }

  .formq-answer {
    color: var(--ink);
    font-family: var(--font-hand);
    font-size: 1.625rem;
    font-weight: 700;
    line-height: 1;
  }

  /* Each answer has its own note; only the selected answer's note shows. */
  .formq-note {
    display: none;
    align-items: center;
    gap: 8px;
    color: var(--red-pen);
    font-family: var(--font-hand);
    font-size: 1.25rem;
    line-height: 1.2;
    white-space: nowrap;
    transform: rotate(-3deg);
  }

  .formq-input:checked ~ .formq-note {
    display: inline-flex;
  }

  @media (max-width: 639.98px) {
    .formq {
      padding: 24px;
      transform: none;
    }

    .formq-question {
      flex-basis: 100%;
      font-size: 1.25rem;
    }

    .formq-options {
      min-width: 0;
      width: 100%;
    }

    .formq-note {
      transform: none;
    }
  }
</style>
