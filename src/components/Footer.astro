---
import { SITE, isSet } from "../config";

interface Props {
  subscribeHref: string;
}

const { subscribeHref } = Astro.props;
const xUrl = isSet(SITE.xHandle)
  ? `https://x.com/${SITE.xHandle.replace(/^@/, "")}`
  : undefined;
---

<footer class="footer">
  <div class="footer-inner wrap">
    <span>© notnottechnical.com</span>
    <ul class="footer-links">
      <li><a href="/rss.xml">RSS</a></li>
      {/* The X link appears once SITE.xHandle is filled in. */}
      {xUrl && <li><a href={xUrl} rel="me">Follow on X</a></li>}
      <li><a href={SITE.githubRepo}>Source on GitHub</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href={subscribeHref}>Subscribe</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--border);
    background: var(--paper);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 16px;
    align-items: center;
    padding-block: 20px;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    list-style: none;
  }

  .footer-links a {
    display: inline-block;
    padding-block: 8px;
  }
</style>
