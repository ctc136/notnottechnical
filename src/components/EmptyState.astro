---
interface Props {
  subscribeHref: string;
}

const { subscribeHref } = Astro.props;
---

<p class="empty">
  Entry #001 drops soon. <a href={subscribeHref}>Subscribe</a> so you don't miss it.
</p>

<style>
  .empty {
    max-width: 520px;
    padding: 24px;
    border: 2px dashed var(--text);
    border-radius: var(--radius);
    background: var(--card);
    font-family: var(--font-hand);
    font-size: 1.375rem;
    line-height: 1.4;
  }
</style>
